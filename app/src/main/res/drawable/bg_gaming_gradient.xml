<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nền đen tuyền, ngả đỏ sẫm nhẹ -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#08090D"
                android:centerColor="#0C0808"
                android:endColor="#120707" />
        </shape>
    </item>

    <!-- Quầng sáng đỏ neon góc trên phải -->
    <item
        android:gravity="top|end"
        android:width="420dp"
        android:height="420dp"
        android:top="-150dp"
        android:end="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerColor="#40FF2D2D"
                android:endColor="#0008090D" />
        </shape>
    </item>

    <!-- Quầng sáng cam góc dưới trái -->
    <item
        android:gravity="bottom|start"
        android:width="380dp"
        android:height="380dp"
        android:bottom="-120dp"
        android:start="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:centerColor="#33FF6B00"
                android:endColor="#0008090D" />
        </shape>
    </item>

    <!-- Vệt chéo neon đỏ mỏng, phong cách "slash" -->
    <item android:gravity="center" android:top="-260dp">
        <rotate
            android:fromDegrees="-18"
            android:toDegrees="-18"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#00FF2D2D"
                    android:centerColor="#33FF2D2D"
                    android:endColor="#00FF2D2D" />
                <size android:height="2dp" />
            </shape>
        </rotate>
    </item>

</layer-list>

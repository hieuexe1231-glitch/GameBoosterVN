<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hud_card"
    android:padding="6dp">

    <!-- Thanh kéo + nút thu gọn / đóng -->
    <LinearLayout
        android:id="@+id/hudDragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⋮⋮ GAME SPACE"
            android:textColor="#FF6B00"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/btnCollapseHud"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnCloseHud"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="✕"
            android:textColor="#FF2D2D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Nội dung đầy đủ: 2 đồng hồ đo + hàng nút tắt nhanh. Mặc định ẨN (GONE) khi vừa
         hiện HUD - đỡ chiếm diện tích màn hình lúc đang chơi, người dùng tự bấm vào
         thanh kéo (hudDragHandle) để mở rộng khi cần xem/bấm. Kích thước cũng được thu
         nhỏ so với bản cũ (88dp→56dp, nút 40dp→30dp) vì GaugeRingView tự co giãn chữ
         theo % chiều rộng (xem GaugeRingView.onDraw) nên thu nhỏ không vỡ layout. -->
    <LinearLayout
        android:id="@+id/hudFullContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.boostvn.gamebooster.GaugeRingView
                android:id="@+id/gaugeCpu"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp" />

            <com.boostvn.gamebooster.GaugeRingView
                android:id="@+id/gaugeRam"
                android:layout_width="56dp"
                android:layout_height="56dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvHudExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="PIN -- · PING -- · 🌡 --°C"
            android:textColor="#9C9494"
            android:textSize="9sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp" />

        <!-- Hàng nút tắt nhanh -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btnHudKillBg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_icon_btn"
                android:gravity="center"
                android:text="🧹"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnHudDnd"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_icon_btn"
                android:gravity="center"
                android:text="🔕"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnHudRefreshPing"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_hud_icon_btn"
                android:gravity="center"
                android:text="📶"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
